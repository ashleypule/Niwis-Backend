      {"id": "D1", "label": "Moderate Drought", "max": -0.8, "probability": "10–20%", "impact": "Streams/dams low"},
      {"id": "D0", "label": "Abnormally Dry", "max": -0.5, "probability": "20–30%", "impact": "Pasture/crop stress starting"}
