  "info": {
    "description": "\nBackend for the National Integrated Water Information System (DWS). Serves the frontend contract\n(`reference/API_CONTRACT.md`) from the NIWIS Supabase database, read-only.\n\n* All data are per **district municipality** (52). See `docs/CONTRACT_CHANGES.md` for additions to the contract:\n  provenance (`asOf`, `source`, `isStale`, `components`, `baseline`, `aggregation`) and the\n  **501 `DATA_UNAVAILABLE`** convention for panels the database cannot serve yet.\n* `/api/v1/health` and `/api/v1/meta/*` describe database coverage and freshness.\n",
    "title": "NIWIS API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/health": {
      "get": {
        "operationId": "health_api_v1_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Health Api V1 Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "DB connectivity and per-module status",
        "tags": [
          "meta"
        ]
      }
    },
