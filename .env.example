# Copy to .env and fill in the four Supabase values. Never commit .env.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon key>
SUPABASE_SERVICE_ROLE_KEY=<service role key (rotated)>
# Supabase dashboard -> Connect -> "Session pooler" connection string
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<password>@<host>:5432/postgres

# Table lists use the actual DB names (note the space in 4_6 and the dots in 5.x / 6.x).
NIWIS_SUPABASE_TABLES_MODULE_1=meteorological_drought_master,satellite_remote_sensing,hydrological_drought_master
NIWIS_SUPABASE_TABLES_MODULE_2=4_1_temperature_change_master,4_2_wet_dry_spells_master,4_3_mean_annual_precipitation_master,4_4_potential_evaporation_daily_master,4_5_irrigation_demand_daily_master,4_6_streamflow_and_climate_linkage_annual _master
NIWIS_SUPABASE_TABLES_MODULE_3=5.1_primary_satellite_vegetation_variables_sansa_master,5.2_meteorological_drivers_saws_master
NIWIS_SUPABASE_TABLES_MODULE_4=6.1_core_rainfall_variables_master,6.2_rainfall_derived_drought_indices_master
NIWIS_SUPABASE_TABLES_MODULE_5=runoff_variables_master,7.2_derived_runoff_indicators_master

# Browser origins allowed to call the API (GET only, no credentials). Empty = "*" (public data, frontend domain not
# fixed yet); set it to the frontend's domain(s) in production, e.g. https://niwis.dws.gov.za
CORS_ORIGINS=

# Deployment: ENV=production refuses to start unless DB_READONLY_ROLE_CONFIRMED=true, i.e. SUPABASE_DB_URL connects as
# the read-only role of migrations/proposed/001_readonly_api_role.sql (see DEPLOYMENT.md)
# ENV=development
# DB_READONLY_ROLE_CONFIRMED=false

# Optional (defaults shown)
# STALE_AFTER_DAYS=90
# DROUGHT_CLASS_AREA_PCT=20            # headline drought class: worst class on >= this % of the area
# RATE_LIMIT_PER_MINUTE=600            # per client IP; 0 disables
# RATE_LIMIT_TRUSTED_CIDRS=           # comma-separated networks that are never limited (e.g. the DWS network)
# TRUST_PROXY_HEADERS=false           # true only behind a reverse proxy that sets X-Forwarded-For
# TRUSTED_PROXY_CIDRS=                # with it: only these peers' X-Forwarded-For is believed (e.g. 172.16.0.0/12)
# MAX_REQUEST_BODY_BYTES=16384        # every endpoint is a GET; larger bodies get 413
# MAX_QUERY_LENGTH=4096               # longer query strings get 414
# RESPONSE_CHECKS=log                 # log | raise | off (app/core/response_checks.py)
# DB_POOL_MAX=5
# DB_STATEMENT_TIMEOUT_MS=10000
# LOG_LEVEL=INFO
# Forecasting (app/forecasting, README "Configuration")
# FORECAST_ENABLED=true
# FORECAST_WORKERS=2                  # worker processes training at once; 0 = in-process (tests)
# FORECAST_TIMEOUT_S=120
# FORECAST_RUNS_PER_HOUR=10           # new Studio runs per client IP; 0 disables the limit
# FORECAST_QUEUE_LIMIT=20
# FORECAST_RETENTION_H=24
# FORECAST_PAGES=true                 # precompute the pages' forecasts (national + provinces) on startup / new data
# FORECAST_PAGE_PROVINCES=true
# FORECAST_PAGE_DISTRICTS=true        # … then the outlook variables per district (quick models), for the outlook maps
# FORECAST_PAGE_ON_DEMAND=true        # any other variable × area is computed the first time its forecast tab is opened
# FORECAST_PAGE_CHECK_S=1800
# Module 6: dams §8
NIWIS_SUPABASE_TABLES_MODULE_6=8_1_reservoir_operational_master
# Module 7: surface water §9
NIWIS_SUPABASE_TABLES_MODULE_7=9_1_hydrological_station_master,9_2_catchment_characteristics_master,9_3_sansa_earth_observation_master
# Module 8: groundwater §10
NIWIS_SUPABASE_TABLES_MODULE_8=10_1_borehole_and_aquifer_master,10_2_recharge_supporting _master
# Module 9: groundwater reserve §11
NIWIS_SUPABASE_TABLES_MODULE_9=11_1_hydrogeological,11.2_recharge_and_discharge,11.3_aquifer_sustainability
# Module 10: water quality §12
NIWIS_SUPABASE_TABLES_MODULE_10=12.1_physical_water_quality_master,12.2_chemical_water_quality_master,12.3_biological_water_quality_master,12.4_sansa_water_quality_master
# Module 11: wastewater / Green Drop §13
NIWIS_SUPABASE_TABLES_MODULE_11=13.1_wastewater_effluent_quality_master,13.2_WWTW_operational_master,13.3_meteorological_variables_(SAWS)_for_WWTW_Compliance_master
# Module 12: drinking water / Blue Drop §14
NIWIS_SUPABASE_TABLES_MODULE_12=14.1_SANS_241_compliance_master
# Module 13: RWQO §15
NIWIS_SUPABASE_TABLES_MODULE_13=15.1_ecological_variables_master,15.2_chemical_RWQO_variables_master,15.3_hydrological_RWQO_variables_master
# Module 14: IWRM §16
NIWIS_SUPABASE_TABLES_MODULE_14=16_1_complete_wrm_matrix_master
# Module 17: water quantity §17 (registered 2026-10-29, DECISIONS D42)
NIWIS_SUPABASE_TABLES_MODULE_17=17_1_water_quantity_assessment_transfers_master,17_2_national_water_balance_master
# Module 18: water services §18; Module 19: tariffs §19 (registered 2026-10-29, DECISIONS D46)
NIWIS_SUPABASE_TABLES_MODULE_18=18_1_water_access_and_coverage_master,18_2_infrastructure_operational_master,18_3_sansa_eo_support_for_services_masters
NIWIS_SUPABASE_TABLES_MODULE_19=19_1_raw_water_tariff_master,19_2_municipal_water_tariff_master,19_3_water_quality_cost_master
