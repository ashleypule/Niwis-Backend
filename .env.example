# Copy to .env and fill in the four Supabase values. Never commit .env.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon key>
SUPABASE_SERVICE_ROLE_KEY=<service role key (rotated)>
# Supabase dashboard -> Connect -> "Session pooler" connection string
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<password>@<host>:5432/postgres

NIWIS_SUPABASE_TABLES_MODULE_1=meteorological_drought_master,satellite_remote_sensing,hydrological_drought_master
NIWIS_SUPABASE_TABLES_MODULE_2=4_1_temperature_change_master,4_2_wet_dry_spells_master,4_3_mean_annual_precipitation_master,4_4_potential_evaporation_daily_master,4_5_irrigation_demand_daily_master,4_6_streamflow_and_climate_linkage_annual_master
NIWIS_SUPABASE_TABLES_MODULE_3=5_1_primary_satellite_vegetation_variables_sansa_master,5_2_meteorological_drivers_saws_master
NIWIS_SUPABASE_TABLES_MODULE_4=6_1_core_rainfall_variables_master,6_2_rainfall_derived_drought_indices_master
NIWIS_SUPABASE_TABLES_MODULE_5=runoff_variables_master

# Local frontend dev servers
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
